@using Ts.ShopIn.Client.ViewModels.ProductVms
@model GetProductForListViewVm
<div class="featured">
    <div class="case-hover">
        <div class="txt-top-left font-20">Featured</div>
        <a asp-page="/product/view" asp-route-shopCategoryName="@Model.ShopCategoryName" asp-route-productDetailLink="@Model.ProductDetailLink" title="@Model.Title">
            @if (Model.MainImageUrl != null)
            {
                <img class="case-img f-height" src="@Model.MainImageUrl" alt="@Model.Title" onerror="loadAlternateImage(this);" />
            }
            else
            {
                <img class="case-img f-height" src="~/images/static-images/alternate-post.jpg" alt="@Model.Title" asp-append-version="true" />
            }
            <div class="txt-bottom-left">
                <div class="case-link p-l-r-4">@Model.Title</div>
            </div>
        </a>
    </div>
</div>