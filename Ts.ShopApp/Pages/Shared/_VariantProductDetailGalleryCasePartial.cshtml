@using Ts.ShopIn.Client.ViewModels.ProductDetailVms
@model ProductDetailVm
@if (Model != null)
    foreach (var item in Model.ProductVariants)
    {
        <div class="case-variant">
            <div class="case-hover @(item.Id == Model.Id ? "case-selected" : "")">
                <div class="txt-top-left-variant">@item.PublishedOnIst</div>
                <div class="txt-price-left-variant">@item.Currency@item.Price</div>
                <a asp-page="/product/view" asp-route-shopCategoryName="@item.ShopCategoryName" asp-route-productDetailLink="@item.ProductDetailLink" title="@item.Title">
                    @if (item.MainImageUrl != null)
                    {
                        <img class="case-img v-height" src="@item.MainImageUrl" alt="@item.Title" onerror="loadAlternateImage(this);" />
                    }
                    else
                    {
                        <img class="case-img v-height" src="~/images/static-images/alternate-post.jpg" alt="@item.Title" asp-append-version="true" />
                    }
                    <div class="show-link">
                        <div class="case-link-variant">@item.Title</div>
                    </div>
                </a>
            </div>
        </div>
    }
