@{
    var title = configuration["SiteTitle"];
}

<!DOCTYPE html>
<html lang="en">
<head>
    <partial name="_HeadTagPartial" />
    @await RenderSectionAsync("Heads", required: false)
</head>
<body>
    <div id="alertContainer" class="alert-container"></div>
    <div id="sessionContainer" class="session-container"></div>
    <partial name="_GtmBodyPartial" />
    <div class="header-top">
        <div class="header">
            <div class="header-left">
                <div class="header-icon">
                    <i class="fa fa-bars" id="menu-icon"></i>
                </div>
                <div class="logo">
                    <a asp-page="/index" title="@title"><img src="~/images/static-images/logo.png" alt="Logo" /><span class="brand-name">@title</span></a>
                </div>
                @if (User.Identity.IsAuthenticated)
                {
                    <div class="middle-icon">
                        <i class="fa fa-user-cog" title="User Details" id="user-icon"></i>
                    </div>
                }
                <div class="middle-icon">
                    <a asp-page="/cart/index" title="Shopping Cart"><i class="fa fa-shopping-cart" id="shopping-icon"></i></a>
                </div>
                @if (!User.Identity.IsAuthenticated)
                {
                    <div class="middle-icon-login">
                        <a asp-page="/account/index" title="Login or Register"><i class="fa fa-sign-in-alt"></i> <span>Login</span></a>
                    </div>
                }
                <div class="header-icon">
                    <i class="fa fa-search" id="search-icon"></i>
                </div>
            </div>
            <div class="header-right" id="search">
                <form method="get" asp-page="/product/search">
                    <div class="search-control">
                        <input name="q" id="searchTxt" placeholder="Search here..." class="form-control" value="@ViewBag.Search" />
                        <button type="submit" title="Search" class="btn" id="searchBtn"><i class="fa fa-search"></i></button>
                    </div>
                </form>
            </div>
        </div>
        <div class="menu" id="menu">
            <partial name="_MenuPartial" />
        </div>
        @RenderSection("Submenu", required: false)
        @if (User.Identity.IsAuthenticated)
        {
            <div class="user-menu" id="user-menu" style="display:none;">
                <partial name="_UserMenuPartial" />
            </div>
        }
    </div>
    <div class="wrapper">
        <div class="sub-wrapper">
            @RenderBody()
        </div>
    </div>
    <div class="footer">
        <div class="footer-left">
            <a asp-page="/about" title="About @title">About Us</a>.
            <a asp-page="/term" title="Terms & Conditions">Terms & Conditions</a>.
            <a asp-page="/privacypolicy" title="Privacy Policy">Privacy Policy</a>.
            <a asp-page="/refundpolicy" title="Refund & Cancellation Policy">Refund & Cancellation Policy</a>.
            <a asp-page="/deliverypolicy" title="Shipping & Delivery Policy">Shipping & Delivery Policy</a>.
            <a asp-page="/disclaimer" title="Disclaimer">Disclaimer</a>.
            <a asp-page="/contact" title="Contact Us">Contact Us</a>
        </div>
        <div class="footer-right">
            &copy; 2020 - @DateTime.Today.Year <a asp-page="/index" title="&copy; @title">@title</a>
        </div>
    </div>
    <partial name="_CookieConsentPartial" />
    <partial name="_ScriptTagPartial" />
    <partial name="_StatusMessagePartial" />
    <partial name="AdsPartials/_AllowAdPartial" />
    <script>
        $('#searchBtn').click(function (event) {
            event.preventDefault();
            var q = $('#searchTxt').val();
            if (q != null && q != "") {
                $(this).attr('disabled', true).find('i').removeClass().addClass('fa fa-spinner fa-spin');
                $(this).closest("form").submit();
            }
        });
    </script>

    @if (User.Identity.IsAuthenticated)
    {
        <script>
            sessionNotification('@((User.Claims.GetRefreshTokenExpiryAt() - DateTime.UtcNow.AddMinutes(2)).Value.TotalMilliseconds)');
        </script>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>