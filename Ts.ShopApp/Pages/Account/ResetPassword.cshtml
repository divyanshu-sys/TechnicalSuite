@page "/resetpassword"
@model Ts.ShopApp.Pages.Account.ResetPasswordModel
@{
    ViewBag.Title = "Reset Password";
    ViewBag.Description = "Reset Password";
}
@section Heads {
    <meta name="robots" content="noindex, follow">
}

<div class="small-width">
    <h1>@ViewBag.Title</h1>
    <div class="form-box">
        <div class="form-border">
            <form method="post" autocomplete="off">
                <div asp-validation-summary="ModelOnly"></div>
                <div class="form-col">
                    <label asp-for="Model.Password"></label>
                    <input class="form-control" asp-for="Model.Password" />
                    <span asp-validation-for="Model.Password"></span>
                </div><div class="form-col">
                    <label asp-for="Model.ConfirmPassword"></label>
                    <input class="form-control" asp-for="Model.ConfirmPassword" />
                    <span asp-validation-for="Model.ConfirmPassword"></span>
                </div>
                <div class="form-col-100per">
                    <button type="submit" class="btn submitLoader" title="Reset Password">Reset Password</button>
                </div>
                <div class="form-col-100per">
                    <a asp-page="/account/index">Return to Login</a>
                </div>
            </form>
        </div>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
