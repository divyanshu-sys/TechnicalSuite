@page "/changepassword"
@model Ts.ShopApp.Pages.Account.ChangePasswordModel
@{
    ViewBag.Title = "Update Password";
    ViewBag.Description = "Update Password";
}
@section Heads {
    <meta name="robots" content="noindex, follow">
}

<div class="small-width">
    <h1>@ViewBag.Title</h1>
    <div class="form-box">
        <div class="form-border">
            <form method="post" autocomplete="off">
                <div asp-validation-summary="ModelOnly"></div>
                <div class="form-row">
                    <div class="form-col">
                        <label asp-for="Model.CurrentPassword"></label>
                        <input class="form-control" asp-for="Model.CurrentPassword" />
                        <span asp-validation-for="Model.CurrentPassword"></span>
                    </div>
                    <div class="form-col">
                        <label asp-for="Model.Password"></label>
                        <input class="form-control" asp-for="Model.Password" />
                        <span asp-validation-for="Model.Password"></span>
                    </div>
                </div>
                <div class="form-col">
                    <label asp-for="Model.ConfirmPassword"></label>
                    <input class="form-control" asp-for="Model.ConfirmPassword" />
                    <span asp-validation-for="Model.ConfirmPassword"></span>
                </div>
                <div class="form-col-100per">
                    <button type="submit" class="btn submitLoader" title="Update Password">Update Password</button>
                </div>
                <div class="form-col-100per">
                    <a asp-page="/account/profile">Return to Profile</a>
                </div>
            </form>
        </div>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
