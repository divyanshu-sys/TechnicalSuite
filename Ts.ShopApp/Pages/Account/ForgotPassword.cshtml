@page "/forgotpassword"
@model Ts.ShopApp.Pages.Account.ForgotPasswordModel
@{
    ViewBag.Title = "Forgot Password";
    ViewBag.Description = "Forgot Password";
}
@section Heads {
    <meta name="robots" content="noindex, follow">
}

<div class="small-width">
    <h1>@ViewBag.Title</h1>
    <p>Enter your email address below and we'll send you a link to reset your password! Please check spam folder if not found in inbox.</p>
    <div class="form-box">
        <div class="form-border">
            <form method="post" autocomplete="off">
                <div asp-validation-summary="ModelOnly"></div>
                <div class="form-col">
                    <label asp-for="Model.Email"></label>
                    <input class="form-control" asp-for="Model.Email" />
                    <span asp-validation-for="Model.Email"></span>
                </div>
                <div class="form-col-100per">
                    <button type="submit" class="btn submitLoader" title="Get Reset Link">Get Reset Link</button>
                </div><div class="form-col-100per">
                    <a asp-page="/account/index">Return to Login</a>
                </div>
            </form>
        </div>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

