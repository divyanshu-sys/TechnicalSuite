{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  //"AllowedHosts": "*",
  "ChangeEmailLinkValidFromMinutes": 5,
  "ResetPasswordLinkValidFromMinutes": 5,
  "ConfirmEmailLinkValidFromMinutes": 5,
  "DefaultTokenValidFromMinutes": 5,
  "DataProtectionKeyExpireTimeInDays": 7,
  "AllowedImageContentTypes": [ "image/jpg", "image/jpeg", "image/jpeg2", "image/pjpeg", "image/gif", "image/x-png", "image/png", "image/webp" ],
  "AllowedImageFileExtensions": [ "jpg", "png", "gif", "jpeg", "jpeg2", "webp" ],
  "AllowedImageFileSize": 200000,
  "AllowedVideoFileExtensions": [ ".mp4", ".webm", ".mpg", ".ogg", ".avi", ".mov" ],
  "AllowedVideoFileSize": 26214400,
  "AllowedDocumentFileExtensions": [ "pdf", "doc", "docx", "xls", "xlsx", "ppt", "pptx" ],
  "AllowedDocumentFileSize": 10000000,
  "AllowedFormSize": 536870912,
  "DefaultLockoutTimeInMinute": 15,
  "MaxLoginFailedAccessAttempts": 5
}
