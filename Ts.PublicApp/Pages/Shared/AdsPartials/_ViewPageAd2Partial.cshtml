@model bool
<environment exclude="Development">
    @if (Model)
    {
        <div class="show-ads">
            <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-5902017416803134"
                    crossorigin="anonymous"></script>
            <!-- Responsive dotin Ad-2 -->
            <ins class="adsbygoogle"
                 style="display:block"
                 data-ad-client="ca-pub-5902017416803134"
                 data-ad-slot="7049313215"
                 data-ad-format="auto"
                 data-full-width-responsive="true"></ins>
            <script>
                (adsbygoogle = window.adsbygoogle || []).push({});
            </script>
        </div>
    }
</environment>