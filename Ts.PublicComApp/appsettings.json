{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AllowedFormSize": 536870912,
  "SiteTitle": "TechnicalSuite.com",
  "CookieConsent": "Ts.PublicCom.Consent",
  "AntiforgeryName": "Ts.PublicCom.Antiforgery",
  "DotComResilienceSetting": {
    "Rest": {
      "WebApi": {
        "FailureRatio": 0.5,
        "MinimumThroughput": 10,
        "SamplingDurationSeconds": 20,
        "BreakDurationSeconds": 15
      }
    }
  }
}
