@section Scripts {
    <script>
        let tableDataDotIn;
        let tableDataDotCom;
        let tableLoadUniquePageVisitedDotIn;
        let tableLoadUniquePageVisitedDotCom;
        let tableLoadUniquePageVisitedBlogDotIn;
        let tableLoadUniquePageVisitedProductDotIn;

        let chartLoadFinYearSalesProductDotIn;

        $(function () {
            var columns = [
                { data: 'title' },
                { data: 'postLink' },
                {
                    render: function (data, type, row, meta) {
                        return row.category?.name ?? "";
                    }
                },
                {
                    render: function (data, type, row, meta) {
                        return row.subCategory?.name ?? "";
                    }
                },
                {
                    data: 'isPublished',
                    render: function (data, type, row, meta) {
                        if (data) {
                            data = '<b class="text-success">True</b>';
                        }
                        else if (!data) {
                            data = '<b class="text-danger">False</b>';
                        }
                        return data;
                    },
                    className: 'text-center'
                },
                {
                    data: 'publishedOnIst',
                    className: 'text-end'
                },
                {
                    render: function (data, type, row, meta) {
                        return $.trim(`${row.publishedBy?.firstName ?? ""} ${row.publishedBy?.lastName ?? ""}`);
                    }
                },
                {
                    render: function (data, type, row, meta) {
                        let name = $.trim(`${row.postWorker?.firstName ?? ""} ${row.postWorker?.lastName ?? ""}`);
                        return name;
                    }
                },
                {
                    render: function (data, type, row, meta) {
                        return row.postView?.totalViews ?? "";
                    },
                    className: 'text-end'
                },
                {
                    render: function (data, type, row, meta) {
                        return row.postView?.lastViewedOnIst ?? "";
                    },
                    className: 'text-end'
                },
                {
                    data: 'createdOnIst',
                    className: 'text-end'
                },
                {
                    data: 'updatedOnIst',
                    className: 'text-end'
                }
            ];
            tableDataDotIn = initAjaxTable("#TableDataDotIn", [[10, 'desc']], [0, 1, 2, 3, 6, 7], '/post/postdotin?isshowall=true', columns, null, true);
            tableDataDotCom = initAjaxTable("#TableDataDotCom", [[10, 'desc']], [0, 1, 2, 3, 6, 7], '/post/postdotcom?isshowall=true', columns, null, true);

            var columnsViews = [
                { data: 'title' },
                {
                    render: function (data, type, row, meta) {
                        return row.postView?.totalViews ?? "";
                    },
                    className: 'text-end'
                }
            ];

            var columnsBlogViews = [
                { data: 'title' },
                {
                    render: function (data, type, row, meta) {
                        return row.blogView?.totalViews ?? "";
                    },
                    className: 'text-end'
                }
            ];

            var columnsProductViews = [
                { data: 'title' },
                {
                    render: function (data, type, row, meta) {
                        return row.productDetailView?.totalViews ?? "";
                    },
                    className: 'text-end'
                }
            ];

            function getDynamicData() {
                return {
                    lastViewedOnStart: '@Html.Raw(range.Start)',
                    lastViewedOnEnd: '@Html.Raw(range.End)'
                };
            }
            tableLoadUniquePageVisitedProductDotIn = initAjaxTable("#TableLoadUniquePageVisitedProductDotIn", [[1, 'desc']], [0, 1], '/productdetail/productdetaildotin?isshowall=true&ispagesvisited=true', columnsProductViews, getDynamicData, true);
            tableLoadUniquePageVisitedBlogDotIn = initAjaxTable("#TableLoadUniquePageVisitedBlogDotIn", [[1, 'desc']], [0, 1], '/blog/blogdotin?isshowall=true&ispagesvisited=true', columnsBlogViews, getDynamicData, true);
            tableLoadUniquePageVisitedDotIn = initAjaxTable("#TableLoadUniquePageVisitedDotIn", [[1, 'desc']], [0, 1], '/post/postdotin?isshowall=true&ispagesvisited=true', columnsViews, getDynamicData, true);
            tableLoadUniquePageVisitedDotCom = initAjaxTable("#TableLoadUniquePageVisitedDotCom", [[1, 'desc']], [0, 1], '/post/postdotcom?isshowall=true&ispagesvisited=true', columnsViews, getDynamicData, true);

            chartLoadFinYearSalesProductDotIn = initBarChart("#ChartLoadFinYearSalesProductDotIn", '/productdetail/productdetaildotin?handler=FinYearSales', 'Income', 'Total Sales', 0);
        });

        $('#LoadDataDotIn').click(function (event) {
            $("#WrapDataDotIn").show();
            tableDataDotIn.ajax.reload();
        });

        $('#LoadDataDotCom').click(function (event) {
            $("#WrapDataDotCom").show();
            tableDataDotCom.ajax.reload();
        });

        $('#LoadUniquePageVisitedProductDotIn').click(function (event) {
            $("#WrapLoadUniquePageVisitedProductDotIn").show();
            tableLoadUniquePageVisitedProductDotIn.ajax.reload();
        });

        $('#LoadUniquePageVisitedBlogDotIn').click(function (event) {
            $("#WrapLoadUniquePageVisitedBlogDotIn").show();
            tableLoadUniquePageVisitedBlogDotIn.ajax.reload();
        });

        $('#LoadUniquePageVisitedDotIn').click(function (event) {
            $("#WrapLoadUniquePageVisitedDotIn").show();
            tableLoadUniquePageVisitedDotIn.ajax.reload();
        });

        $('#LoadUniquePageVisitedDotCom').click(function (event) {
            $("#WrapLoadUniquePageVisitedDotCom").show();
            tableLoadUniquePageVisitedDotCom.ajax.reload();
        });

        $('#LoadFinYearSalesProductDotIn').click(function (event) {
            $("#WrapLoadFinYearSalesProductDotIn").show();
            chartLoadFinYearSalesProductDotIn.ajax.reload();
        });

        $('#LoadTodayUniquePageViewsProductDotIn').click(function (event) {
            let todayUniquePageViewsProductDotInRequest = new ServerRequest('/productdetail/productdetaildotin?handler=TodayUniquePageViews', '#ValTodayUniquePageViewsProductDotIn', null, 1);
            todayUniquePageViewsProductDotInRequest.showHtmlData();
        });
        $('#LoadYearUniquePageViewsProductDotIn').click(function (event) {
            let yearUniquePageViewsProductDotInRequest = new ServerRequest('/productdetail/productdetaildotin?handler=YearUniquePageViews', '#ValYearUniquePageViewsProductDotIn', null, 2);
            yearUniquePageViewsProductDotInRequest.showHtmlData();
        });
        $('#LoadTotalPageViewsProductDotIn').click(function (event) {
            let totalPageViewsProductDotInRequest = new ServerRequest('/productdetail/productdetaildotin?handler=TotalPageViews', '#ValTotalPageViewsProductDotIn', null, 3);
            totalPageViewsProductDotInRequest.showHtmlData();
        });
        $('#LoadTodayRevenueProductDotIn').click(function (event) {
            let todayRevenueProductDotInRequest = new ServerRequest('/productdetail/productdetaildotin?handler=TodayRevenue', '#ValTodayRevenueProductDotIn', null, 4);
            todayRevenueProductDotInRequest.showHtmlData();
        });
        $('#LoadMonthRevenueProductDotIn').click(function (event) {
            let monthRevenueProductDotInRequest = new ServerRequest('/productdetail/productdetaildotin?handler=MonthRevenue', '#ValMonthRevenueProductDotIn', null, 5);
            monthRevenueProductDotInRequest.showHtmlData();
        });
        $('#LoadFinYearRevenueProductDotIn').click(function (event) {
            let finYearRevenueProductDotInRequest = new ServerRequest('/productdetail/productdetaildotin?handler=FinYearRevenue', '#ValFinYearRevenueProductDotIn', null, 6);
            finYearRevenueProductDotInRequest.showHtmlData();
        });

        $('#LoadTodayUniquePageViewsBlogDotIn').click(function (event) {
            let todayUniquePageViewsBlogDotInRequest = new ServerRequest('/blog/blogdotin?handler=TodayUniquePageViews', '#ValTodayUniquePageViewsBlogDotIn', null, 7);
            todayUniquePageViewsBlogDotInRequest.showHtmlData();
        });
        $('#LoadYearUniquePageViewsBlogDotIn').click(function (event) {
            let yearUniquePageViewsBlogDotInRequest = new ServerRequest('/blog/blogdotin?handler=YearUniquePageViews', '#ValYearUniquePageViewsBlogDotIn', null, 8);
            yearUniquePageViewsBlogDotInRequest.showHtmlData();
        });
        $('#LoadTotalPageViewsBlogDotIn').click(function (event) {
            let totalPageViewsBlogDotInRequest = new ServerRequest('/blog/blogdotin?handler=TotalPageViews', '#ValTotalPageViewsBlogDotIn', null, 9);
            totalPageViewsBlogDotInRequest.showHtmlData();
        });

        $('#LoadTodayUniquePageViewsDotIn').click(function (event) {
            let todayUniquePageViewsDotInRequest = new ServerRequest('/post/postdotin?handler=TodayUniquePageViews', '#ValTodayUniquePageViewsDotIn', null, 10);
            todayUniquePageViewsDotInRequest.showHtmlData();
        });
        $('#LoadYearUniquePageViewsDotIn').click(function (event) {
            let yearUniquePageViewsDotInRequest = new ServerRequest('/post/postdotin?handler=YearUniquePageViews', '#ValYearUniquePageViewsDotIn', null, 11);
            yearUniquePageViewsDotInRequest.showHtmlData();
        });
        $('#LoadTotalPageViewsDotIn').click(function (event) {
            let totalPageViewsDotInRequest = new ServerRequest('/post/postdotin?handler=TotalPageViews', '#ValTotalPageViewsDotIn', null, 12);
            totalPageViewsDotInRequest.showHtmlData();
        });

        $('#LoadTodayUniquePageViewsDotCom').click(function (event) {
            let todayUniquePageViewsDotComRequest = new ServerRequest('/post/postDotCom?handler=TodayUniquePageViews', '#ValTodayUniquePageViewsDotCom', null, 13);
            todayUniquePageViewsDotComRequest.showHtmlData();
        });
        $('#LoadYearUniquePageViewsDotCom').click(function (event) {
            let yearUniquePageViewsDotComRequest = new ServerRequest('/post/postDotCom?handler=YearUniquePageViews', '#ValYearUniquePageViewsDotCom', null, 14);
            yearUniquePageViewsDotComRequest.showHtmlData();
        });
        $('#LoadTotalPageViewsDotCom').click(function (event) {
            let totalPageViewsDotComRequest = new ServerRequest('/post/postDotCom?handler=TotalPageViews', '#ValTotalPageViewsDotCom', null, 15);
            totalPageViewsDotComRequest.showHtmlData();
        });

        $('#ViewsProductDotIn').click(function(event){
            $('#WrapViewsProductDotIn').toggle();
        });

        $('#ViewsBlogDotIn').click(function(event){
            $('#WrapViewsBlogDotIn').toggle();
        });

        $('#ViewsDotIn').click(function(event){
            $('#WrapViewsDotIn').toggle();
        });

        $('#ViewsDotCom').click(function(event){
            $('#WrapViewsDotCom').toggle();
        });
    </script>
}
