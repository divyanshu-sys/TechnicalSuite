@page
@model ChangeEmailModel
@{
    ViewBag.Title = "Change Email";
}

<div class="container col-lg-6">
    <div class="page-title">
        <h3>
            @ViewBag.Title
            <a asp-page="/index" class="btn btn-sm btn-outline-info float-end me-1"><i class="fas fa-angle-left"></i> <span class="btn-header">Dashboard</span></a>
        </h3>
    </div>
    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-header"><i class="fa fa-edit"></i> @ViewBag.Title</div>
                <div class="card-body">
                    <div class="mb-2">
                        <div class="text-primary small">We will send an email to verify.</div>
                    </div>
                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3"></div>
                        <div class="row g-2">
                            <div class="mb-3 col-md-6">
                                <label class="form-label" asp-for="Model.Email"></label>
                                <input class="form-control" asp-for="Model.Email">
                                <span asp-validation-for="Model.Email" class="text-danger small"></span>
                            </div>
                            <div class="mb-3 col-md-6">
                                <label class="form-label" asp-for="Model.ConfirmEmail"></label>
                                <input class="form-control" asp-for="Model.ConfirmEmail">
                                <span asp-validation-for="Model.ConfirmEmail" class="text-danger small"></span>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-primary submitLoader">Change Email</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
