@page "/shopin-user"
@model Ts.AdminApp.Pages.User.ShopInModel
@{
    ViewBag.Title = "ShopIn Users";
}

<div class="container">
    <div class="page-title">
        <h3>
            @ViewBag.Title
        </h3>
    </div>
    <div class="box box-primary">
        <div class="box-body">
            <table width="100%" class="table-hover table compact table-striped-columns" id="DataTable">
                <thead>
                    <tr>
                        <th>User Name</th>
                        <th>First Name</th>
                        <th>Last Name</th>
                        <th>Email</th>
                        <th>Email Confirmed</th>
                        <th>Created On</th>
                        <th>Updated On</th>
                    </tr>
                </thead>
                @* <tfoot>
                <tr>
                <th>User Name</th>
                <th>First Name</th>
                <th>Last Name</th>
                <th>Email</th>
                <th>Created On</th>
                <th>Updated On</th>
                <th>Action</th>
                </tr>
                </tfoot> *@
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function() {
            var columns = [
                { data: 'userName' },
                { data: 'firstName' },
                { data: 'lastName' },
                { data: 'email' },
                {
                    data: 'emailConfirmed',
                    render: function(data, type, row, meta) {
                        if (data) {
                            data = '<b class="text-success">True</b>';
                        }
                        else if (!data) {
                            data = '<b class="text-danger">False</b>';
                        }
                        return data;
                    },
                    className: 'text-center'
                },
                {
                    data: 'createdOnIst',
                    className: 'text-end'
                },
                {
                    data: 'updatedOnIst',
                    className: 'text-end'
                }
            ];
            var userTable = initAjaxTable("#DataTable", [[5, 'desc']], [0, 3, 4], '/shopin-user', columns);
        });
    </script>
}
