@page
@model Ts.AdminApp.Pages.ExceptionHandlerModel
@{
    Layout = null;
    ViewBag.Title = ViewBag.StatusCode;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <partial name="_HeadTagPartial" />
    <environment include="Development">
        <link href="~/css/error.css" asp-append-version="true" rel="stylesheet" />
    </environment>
    <environment exclude="Development">
        <link href="~/css/error.min.css" asp-append-version="true" rel="stylesheet" />
    </environment>
</head>
<body>
    <div class="wrapper">
        <div class="page vertical-align text-center">
            <div class="page-content vertical-align-middle">
                <header>
                    <h1 class="animation-slide-top">@ViewBag.StatusCode</h1>
                    <p>@ViewBag.TagLine</p>
                </header>
                <p class="error-advise">@ViewBag.HeadLine</p>
                <a class="btn btn-primary btn-round mb-5" asp-page="/index">GO TO HOME PAGE</a>
                <footer class="page-copyright">
                    <p>&copy; @DateTime.Now.Year. All RIGHT RESERVED.</p>
                </footer>
            </div>
        </div>
    </div>
</body>
</html>
