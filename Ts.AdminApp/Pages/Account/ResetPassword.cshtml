@page "/resetpassword"
@model Ts.AdminApp.Pages.Account.ResetPasswordModel
@{
    ViewBag.Title = "Reset Password";
}

<h6 class="mb-4 text-muted text-center">@ViewBag.Title</h6>
<form method="post" autocomplete="off">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3"></div>
    <div class="mb-3 text-start">
        <label class="form-label" asp-for="Model.Password"></label>
        <input class="form-control" asp-for="Model.Password">
        <span asp-validation-for="Model.Password" class="text-danger small"></span>
    </div>
    <div class="mb-3 text-start">
        <label class="form-label" asp-for="Model.ConfirmPassword"></label>
        <input class="form-control" asp-for="Model.ConfirmPassword">
        <span asp-validation-for="Model.ConfirmPassword" class="text-danger small"></span>
    </div>
    <div class="text-center">
        <button type="submit" class="btn btn-primary shadow-2 mb-4 submitLoader">Reset Password</button>
    </div>
</form>
<p class="mb-0 text-muted text-center"><a class="small" asp-page="index">Return to Login</a></p>
@section Scripts {
}
