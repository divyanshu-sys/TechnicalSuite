@page "/forgotpassword"
@model Ts.AdminApp.Pages.Account.ForgotPasswordModel
@{
    ViewBag.Title = "Forgot Password";
}

<h6 class="mb-4 text-muted text-center">@ViewBag.Title</h6>
<p class="text-muted text-start">Enter your email address below and we'll send you a link to reset your password!</p>
<form method="post" autocomplete="off">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3"></div>
    <div class="mb-3 text-start">
        <label class="form-label" asp-for="Model.Email"></label>
        <input class="form-control" asp-for="Model.Email">
        <span asp-validation-for="Model.Email" class="text-danger small"></span>
    </div>
    <div class="text-center">
        <button type="submit" class="btn btn-primary shadow-2 mb-4 submitLoader">Get Reset Link</button>
    </div>
</form>
<p class="mb-0 text-muted text-center">Already have an account? <a class="small" asp-page="index">Login</a></p>
@section Scripts {
}
