@page "/changepassword"
@model Ts.AdminApp.Pages.Account.ChangePasswordModel
@{
    ViewBag.Title = "Change Password";
    string changePassword = User.FindFirst(claim => claim.Type == "changepassword")?.Value;
    bool IsChangePassword = !string.IsNullOrEmpty(changePassword) ? Convert.ToBoolean(changePassword) : false;
}

<h6 class="mb-4 text-muted text-center">@ViewBag.Title</h6>
@if (User.Identity.IsAuthenticated && IsChangePassword)
{
    <p class="mb-4 text-danger text-center">Please change your password!</p>
}
<form method="post" autocomplete="off">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3"></div>
    <div class="mb-3 text-start">
        <label class="form-label" asp-for="Model.CurrentPassword"></label>
        <input class="form-control" asp-for="Model.CurrentPassword">
        <span asp-validation-for="Model.CurrentPassword" class="text-danger small"></span>
    </div>
    <div class="mb-3 text-start">
        <label class="form-label" asp-for="Model.Password"></label>
        <input class="form-control" asp-for="Model.Password">
        <span asp-validation-for="Model.Password" class="text-danger small"></span>
    </div>
    <div class="mb-3 text-start">
        <label class="form-label" asp-for="Model.ConfirmPassword"></label>
        <input class="form-control" asp-for="Model.ConfirmPassword">
        <span asp-validation-for="Model.ConfirmPassword" class="text-danger small"></span>
    </div>
    <div class="text-center">
        <button type="submit" class="btn btn-primary shadow-2 mb-4 submitLoader">Change Password</button>
    </div>
</form>
<div class="text-center">
    @if (User.Identity.IsAuthenticated && !IsChangePassword)
    {
        <a class="small" asp-page="/index">Go to Dashboard</a>
    }
    else
    {
        <form method="post" asp-page="/account/logout">
            <button type="submit" class="btn btn-secondary shadow-2 mb-4">Logout</button>
        </form>
    }
</div>
@section Scripts {

}
