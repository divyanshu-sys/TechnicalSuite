@page "{id:min(1)}"
@model Ts.AdminApp.Pages.ProductDetail.ProductDetailDotIn.UpdateProductDetailWorkerModel
@{
    ViewBag.Title = "Update ProductDetail Worker";
}

<div class="container col-lg-6">
    <div class="page-title">
        <h3>
            ProductDetail DotIn
            <a asp-page="index" class="btn btn-sm btn-outline-info float-end me-1"><i class="fas fa-angle-left"></i> <span class="btn-header">Return</span></a>
        </h3>
    </div>
    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-header"><i class="fa fa-edit"></i> @ViewBag.Title</div>
                <div class="card-body">
                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3"></div>
                        <div class="row g-2">
                            <div class="mb-3 col-md-12">
                                <b>@Html.DisplayNameFor(m => m.Model.Title):</b> @Model.Model.Title
                                <input type="hidden" asp-for="Model.Title" />
                            </div>
                            <div class="mb-3 col-md-6">
                                <label class="form-label" asp-for="Model.ProductDetailWorkerId"></label>
                                <select asp-for="Model.ProductDetailWorkerId" class="form-select">
                                    <option value="">Select...</option>
                                </select>
                                <input hidden id="ProductDetailWorkerId_Hidden" value="@Model.Model.ProductDetailWorkerId" />
                                <span asp-validation-for="Model.ProductDetailWorkerId" class="text-danger small"></span>
                            </div>
                        </div>
                        <button type="submit" class="btn btn-primary submitLoader"><i class="fas fa-save"></i> Save</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            $("#Model_ProductDetailWorkerId").select2({
                theme: "classic"
            });
            let serverRequest = new ServerRequest('/productdetail/productdetaildotin?handler=applicationuserdropdown', '#Model_ProductDetailWorkerId', '#ProductDetailWorkerId_Hidden');
            serverRequest.loadDropDown();
        });
    </script>
}
