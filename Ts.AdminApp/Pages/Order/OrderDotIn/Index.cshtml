@page "/order/orderdotin"
@model Ts.AdminApp.Pages.Order.OrderDotIn.IndexModel
@{
    ViewBag.Title = "Orders DotIn";
}

<div class="container">
    <div class="page-title">
        <h3>
            @ViewBag.Title
        </h3>
    </div>
    <div class="box box-primary">
        <div class="box-body">
            <table width="100%" class="table-hover table compact table-striped-columns" id="DataTable">
                <thead>
                    <tr>
                        <th>O. Number</th>
                        <th>Payment Id</th>
                        <th>Client Name</th>
                        <th>O. Qty.</th>
                        <th>O. Amt.</th>
                        <th>OrderedOn</th>
                        <th>P. Gateway</th>
                        <th>P. Method</th>
                        <th>P. Amt.</th>
                        <th>P. Status</th>
                        <th>P. Refund</th>
                        <th>P. Refund Status</th>
                        <th>P. CreatedAt</th>
                        <th>P. UpdatedOn</th>
                        <th>P. History</th>
                        <th>P. Refresh</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let table;
        $(function() {
            var columns = [
                {
                    data: 'orderNumber'
                },
                {
                    render: function(data, type, row, meta) {
                        return `${row.payment?.pay_Payment_Id ?? ""}`;
                    }
                },
                {
                    data: 'clientName'
                },
                {
                    data: 'totalItemCount',
                    className: 'text-end'
                },
                {
                    render: function(data, type, row, meta) {
                        return `${row.currencyType.symbol} ${row.totalAmount}`;
                    },
                    className: 'text-end'
                },
                {
                    data: 'orderedOnIst',
                    className: 'text-end'
                },
                {
                    render: function(data, type, row, meta) {
                        return `${row.payment?.paymentGatewayType.name ?? ""}`;
                    }
                },
                {
                    render: function(data, type, row, meta) {
                        return `${row.payment?.pay_Method ?? ""}`;
                    }
                },
                {
                    render: function(data, type, row, meta) {
                        if (row.payment?.pay_Amount) {
                            return `${row.payment?.currencyType.symbol} ${row.payment?.pay_Amount}`;
                        }
                        return "";
                    },
                    className: 'text-end'
                },
                {
                    render: function(data, type, row, meta) {
                        if ('@RazorpayPaymentStatusConstant.Captured' == row.payment?.paymentStatus?.name) {
                            return `<b class="text-success">${row.payment?.paymentStatus?.name}</b>`;
                        }
                        else if ('@RazorpayPaymentStatusConstant.Refunded' == row.payment?.paymentStatus?.name) {
                            return `<b class="text-info">${row.payment?.paymentStatus?.name}</b>`;
                        }
                        else if ('@RazorpayPaymentStatusConstant.Failed' == row.payment?.paymentStatus?.name) {
                            return `<b class="text-danger">${row.payment?.paymentStatus?.name}</b>`;
                        }
                        return `<b>${row.payment?.paymentStatus?.name ?? ""}</b>`;
                    }
                },
                {
                    render: function(data, type, row, meta) {
                        if (row.payment?.pay_Amount_Refunded) {
                            return `${row.payment?.currencyType.symbol} ${row.payment?.pay_Amount_Refunded}`;
                        }
                        return "";
                    },
                    className: 'text-end'
                },
                {
                    render: function(data, type, row, meta) {
                        return `${row.payment?.pay_Refund_Status ?? ""}`;
                    }
                },
                {
                    render: function(data, type, row, meta) {
                        return `${row.payment?.createdAtIst ?? ""}`;
                    },
                    className: 'text-end'
                },
                {
                    render: function(data, type, row, meta) {
                        return `${row.payment?.updatedOnIst ?? ""}`;
                    },
                    className: 'text-end'
                },
                {
                    render: function(data, type, row, meta) {
                        return `<button type="button" class="btn btn-outline-primary btn-rounded")"><i class="fas fa-history"></i></button>`;
                    },
                    className: 'text-center'
                },
                {
                    render: function(data, type, row, meta) {
                        return `<button type="button" class="btn btn-outline-warning btn-rounded"><i class="fas fa-sync"></i></button>`;
                    },
                    className: 'text-center'
                }
            ];

            table = initAjaxTable("#DataTable", [[5, 'desc']], [0, 1, 2, 3, 4, 5, 7, 8, 9], '/order/orderdotin', columns);
        });
    </script>
}
