@page "/order/orderdotin"
@model Ts.AdminApp.Pages.Order.OrderDotIn.IndexModel
@{
    ViewBag.Title = "Orders DotIn";
}

<div class="container">
    <div class="page-title">
        <h3>
            @ViewBag.Title
        </h3>
    </div>
    <div class="box box-primary">
        <div class="box-body">
            <table width="100%" class="table-hover table compact table-striped-columns" id="DataTable">
                <thead>
                    <tr>
                        <th>Order Number</th>
                        <th>Ordered On</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let table;
        $(function() {
            var columns = [
                {
                    data: 'orderNumber'
                },
                {
                    data: 'orderedOnIst',
                    className: 'text-end'
                }
            ];

            table = initAjaxTable("#DataTable", [[1, 'desc']], [0], '/order/orderdotin', columns);
        });
    </script>
}
