@page "{id:min(1)}/{isRepublish?}"
@model Ts.AdminApp.Pages.Post.PostDotCom.PublishModel
@{
    ViewBag.Title = "Publish or Unpublish Post";
}

<div class="container col-lg-12">
    <div class="page-title">
        <h3>
            Post DotCom
            <a asp-page="index" class="btn btn-sm btn-outline-info float-end me-1"><i class="fas fa-angle-left"></i> <span class="btn-header">Return</span></a>
        </h3>
    </div>
    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-header"><i class="fa fa-edit"></i> @ViewBag.Title</div>
                <div class="card-body">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3"></div>
                    <div class="mb-3 col-md-12">
                        <div class="text-danger small">Note: Description should be there before publishing.</div>
                    </div>
                    <div class="row g-2">
                        <div class="mb-3 col-md-12">
                            <b>@Html.DisplayNameFor(m => m.Model.Title):</b> @Model.Model.Title
                        </div>
                    </div>
                    @if (!Model.Model.IsPublished)
                    {
                        <button class="btn btn-primary mb-1" onClick="showConfirmation('Publish', 'Confirm Publish', 'Are you sure you want to Publish?', '/post/postdotcom/publish/@Model.Id/false')"><i class="fas fa-rocket"></i> Publish</button>
                        @if (Model.Model.PublishedById != null)
                        {
                            <button class="btn btn-warning mb-1" onClick="showConfirmation('Republish', 'Confirm Republish', 'Are you sure you want to Republish?', '/post/postdotcom/publish/@Model.Id/true')"><i class="fas fa-redo"></i> Republish</button>
                        }
                    }
                    else
                    {
                        <button class="btn btn-danger mb-1" onClick="showConfirmation('Unpublish', 'Confirm Unpublish', 'Are you sure you want to Unublish?', '/post/postdotcom/publish/@Model.Id/false')"><i class="fas fa-undo"></i> Unpublish</button>
                    }
                    <a asp-page="updatemainimage" asp-route-id="@Model.Id" class="btn btn-secondary mb-1 float-end"><i class="fas fa-angle-double-left"></i> Main Image</a>
                </div>
            </div>
        </div>
    </div>
</div>
