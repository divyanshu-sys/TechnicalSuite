@page "/master/postoffice"
@model Ts.AdminApp.Pages.Master.PostOffice.IndexModel
@{
    ViewBag.Title = "Post Offices";
}

<div class="container">
    <div class="page-title">
        <h3>
            @ViewBag.Title
            @if (User.HasClaim(x => x.Type == PostOfficePolicy.CanCreate))
            {
                <a asp-page="add" class="btn btn-sm btn-outline-primary float-end"><i class="fas fa-plus-circle"></i> Add Post Office</a>
            }
        </h3>
    </div>
    <div class="box box-primary">
        <div class="box-body">
            <table width="100%" class="table-hover table compact table-striped-columns" id="DataTable">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Pincode</th>
                        <th>District</th>
                        <th>State</th>
                        <th>Country</th>
                        <th>Created On</th>
                        <th>Updated On</th>
                        <th>Action</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>

@{
    var canUpdate = User.HasClaim(x => x.Type == PostOfficePolicy.CanUpdate);
    var canDelete = User.HasClaim(x => x.Type == PostOfficePolicy.CanDelete);
}

@section Scripts {
    <script>
        $(function () {
            var columns = [
                { data: 'name' },
                { data: 'pincode' },
                { data: 'district.name' },
                { data: 'district.state.name' },
                { data: 'district.state.country.name' },
                {
                    data: 'createdOnIst',
                    className: 'text-end'
                },
                {
                    data: 'updatedOnIst',
                    className: 'text-end'
                },
                {
                    data: 'id',
                    render: function (data, type, row, meta) {
                        let link = '';
                        let canUpdate = @canUpdate.ToString().ToLower();
                        let canDelete = @canDelete.ToString().ToLower();
                        if (canUpdate)
                            link += `<a href="/master/postoffice/edit/${data}" class="btn btn-outline-info btn-rounded"> <i class="fas fa-pen"> </i></a>`;
                        if (canDelete)
                            link += ` <button type="button" class="btn btn-outline-danger btn-rounded" onClick="showConfirmation('Delete', 'Confirm Delete', 'Are you sure you want to delete?', '/master/postoffice/delete/${data}')"><i class="fas fa-trash"></i></button>`;

                        return link;
                    },
                    className: 'text-end'
                }
            ];
            let table = initAjaxTable("#DataTable", [[5, 'desc']], [1, 2, 3, 4, 7], '/master/postoffice', columns);
        });
    </script>
}
