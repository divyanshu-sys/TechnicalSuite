@page "{id:min(1)}"
@model Ts.AdminApp.Pages.Story.StoryDotCom.UpdateStoryRelativeModel
@{
    ViewBag.Title = "Update Story Relative";
}

<div class="container col-lg-12">
    <div class="page-title">
        <h3>
            Story DotCom
            <a asp-page="index" class="btn btn-sm btn-outline-info float-end me-1"><i class="fas fa-angle-left"></i> <span class="btn-header">Return</span></a>
        </h3>
    </div>
    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-header"><i class="fa fa-edit"></i> @ViewBag.Title</div>
                <div class="card-body">
                    <form method="post" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3"></div>
                        <div class="row g-2">
                            <div class="mb-3 col-md-12">
                                <b>@Html.DisplayNameFor(m => m.ModelVm.Title):</b> @Model.ModelVm.Title
                            </div>
                            <div class="mb-3 col-md-4">
                                <label class="form-label" asp-for="Model.HrefLangId"></label>
                                <select asp-for="Model.HrefLangId" class="form-select">
                                    <option value="">Select...</option>
                                </select>
                                <input hidden id="HrefLangId_Hidden" value="@Model.Model?.HrefLangId" />
                                <span asp-validation-for="Model.HrefLangId" class="text-danger small"></span>
                            </div>
                            <div class="mb-3 col-md-8">
                                <label class="form-label" asp-for="Model.Href"></label>
                                <input class="form-control" asp-for="Model.Href">
                                <span asp-validation-for="Model.Href" class="text-danger small"></span>
                            </div>
                        </div>
                        <button type="submit" class="btn btn-primary submitLoader"><i class="fas fa-save"></i> Save</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
    <div class="box box-primary">
        <div class="box-body">
            <table width="100%" class="table-hover table compact table-striped-columns" id="DataTable">
                <thead>
                    <tr>
                        <th>HrefLang</th>
                        <th>Href</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.ModelVm.StoryRelative != null && Model.ModelVm.StoryRelative.StoryRelativeHelpers.Any())
                    {
                        foreach (var item in Model.ModelVm.StoryRelative.StoryRelativeHelpers)
                        {
                            <tr>
                                <td class="copyText" title="Click to copy HrefLang">@item.HrefLang</td>
                                <td class="copyText" title="Click to copy Href">@item.Href</td>
                                <td class="text-center">
                                    <button type="button" class="btn btn-outline-danger btn-rounded" onClick="showConfirmation('Delete', 'Confirm Delete', 'Are you sure you want to delete?', '/story/storydotcom/deletestoryrelative/@Model.Id/@item.HrefLang')"><i class="fas fa-trash"></i> </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            let dataTable = initTable("#DataTable", [], [0, 1, 2]);

            $("#Model_HrefLangId").select2({
                theme: "classic"
            });

            let hrefLangServerRequest = new ServerRequest('/story/storydotcom?handler=hreflangdropdown', '#Model_HrefLangId', '#HrefLangId_Hidden');
            hrefLangServerRequest.loadDropDown();
        });

        $('.copyText').click(function () {
            let copyText = $(this);
            copyText.select();
            navigator.clipboard.writeText(copyText.text());
        });
    </script>
}