@page "{id:min(1)}/{descriptionId?}"
@model Ts.AdminApp.Pages.Story.StoryDotIn.UpdateDescriptionModel
@{
    ViewBag.Title = "Update Description";
}

<div class="container col-lg-12">
    <div class="page-title">
        <h3>
            Story DotIn
            <a asp-page="index" class="btn btn-sm btn-outline-info float-end me-1"><i class="fas fa-angle-left"></i> <span class="btn-header">Return</span></a>
        </h3>
    </div>
    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-header"><i class="fa fa-edit"></i> @ViewBag.Title</div>
                <div class="card-body">
                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3"></div>
                        <div class="row g-2">
                            <div class="mb-3 col-md-12">
                                <b>@Html.DisplayNameFor(m => m.ModelVm.Title):</b> @Model.ModelVm.Title
                            </div>
                            <div class="mb-3 col-md-8">
                                <label class="form-label" asp-for="Model.Title"></label>
                                <input class="form-control" asp-for="Model.Title">
                                <span asp-validation-for="Model.Title" class="text-danger small"></span>
                            </div>
                            <div class="mb-3 col-md-12">
                                <label class="form-label" asp-for="Model.Description"></label>
                                <input class="form-control" asp-for="Model.Description">
                                <span asp-validation-for="Model.Description" class="text-danger small"></span>
                            </div>
                            <div class="mb-3 col-md-4">
                                <label class="form-label" asp-for="Model.Image"></label>
                                <input class="form-control" asp-for="Model.Image">
                                <span asp-validation-for="Model.Image" class="text-danger small"></span>
                            </div>
                            <div class="mb-3 col-md-4">
                                <label class="form-label" asp-for="Model.ImageSource"></label>
                                <input class="form-control" asp-for="Model.ImageSource">
                                <span asp-validation-for="Model.ImageSource" class="text-danger small"></span>
                            </div>
                            <div class="mb-3 col-md-4">
                                <label class="form-label" asp-for="Model.Priority"></label>
                                <input class="form-control" asp-for="Model.Priority">
                                <span asp-validation-for="Model.Priority" class="text-danger small"></span>
                            </div>
                        </div>
                        <button type="submit" class="btn btn-primary submitLoader mb-1"><i class="fas fa-save"></i> Save</button>
                        @if (User.HasClaim(x => x.Type == StoryPolicy.CanPublish))
                        {
                            <a asp-page="publish" asp-route-id="@Model.Id" class="btn btn-secondary mb-1 float-end"><i class="fas fa-angle-double-right"></i> Publish Story</a>
                        }
                        <a asp-page="updatemainimage" asp-route-id="@Model.Id" class="btn btn-secondary float-end me-2 mb-1"><i class="fas fa-angle-double-left"></i> Main Image</a>
                        <a asp-page="updatestoryimage" target="_blank" asp-route-id="@Model.Id" class="btn btn-warning me-4 mb-1 float-end"><i class="fas fa-images"></i> Image</a>
                    </form>
                </div>
            </div>
        </div>
    </div>
    <div class="box box-primary">
        <div class="box-body">
            <table width="100%" class="table-hover table compact table-striped-columns" id="DataTable">
                <thead>
                    <tr>
                        <th>Title</th>
                        <th>Description</th>
                        <th>Image</th>
                        <th>Image Name</th>
                        <th>Image Souce</th>
                        <th>Priority</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.ModelVm.StoryDescriptionHelperVms != null && Model.ModelVm.StoryDescriptionHelperVms.Any())
                    {
                        foreach (var descriptionHelperVm in Model.ModelVm.StoryDescriptionHelperVms)
                        {
                            <tr>
                                <td>@descriptionHelperVm.Title</td>
                                <td>@descriptionHelperVm.Description</td>
                                <td><img src="@Model.ModelVm.ImageBaseUrl/@descriptionHelperVm.Image" alt="Image" width="150" class="max-w-100" /></td>
                                <td>@descriptionHelperVm.Image</td>
                                <td>@descriptionHelperVm.ImageSource</td>
                                <td>@descriptionHelperVm.Priority</td>
                                <td class="text-center">
                                    <a href="/story/storydotin/updatedescription/@Model.Id/@descriptionHelperVm.Id" class="btn btn-outline-info btn-rounded"><i class="fas fa-pen"></i></a> <button type="button" class="btn btn-outline-danger btn-rounded" onClick="showConfirmation('Delete', 'Confirm Delete', 'Are you sure you want to delete?', '/story/storydotin/deletedescription/@Model.Id/@descriptionHelperVm.Id')"><i class="fas fa-trash"></i> </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            let dataTable = initTable("#DataTable", [[5, 'asc']], [0, 1, 2, 3, 4, 6]);
        });
    </script>
}
