@page "{id:min(1)}"
@model Ts.AdminApp.Pages.Product.ProductDotIn.EditModel
@{
    ViewBag.Title = "Update Product";
}

<div class="container col-lg-12">
    <div class="page-title">
        <h3>
            Product DotIn
            <a asp-page="index" class="btn btn-sm btn-outline-info float-end me-1"><i class="fas fa-angle-left"></i> <span class="btn-header">Return</span></a>
        </h3>
    </div>
    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-header"><i class="fa fa-edit"></i> @ViewBag.Title</div>
                <div class="card-body">
                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3"></div>
                        <div class="row g-2">
                            <div class="mb-3 col-md-12">
                                <label class="form-label" asp-for="Model.Title"></label>
                                <input class="form-control" asp-for="Model.Title">
                                <span asp-validation-for="Model.Title" class="text-danger small"></span>
                            </div>
                            <div class="mb-3 col-md-4">
                                <div class="form-check">
                                    <input class="form-check-input" asp-for="Model.IsAvailable">
                                    <label class="form-check-label" asp-for="Model.IsAvailable"></label>
                                </div>
                            </div>
                        </div>
                        <button type="submit" class="btn btn-primary submitLoader"><i class="fas fa-save"></i> Save</button>
                        <a asp-page="updatemainimage" asp-route-id="@Model.Id" class="btn btn-secondary float-end"><i class="fas fa-angle-double-right"></i> Main Image</a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
}
